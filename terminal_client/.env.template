# WhisperDoc Client Configuration

# Server URI (WebSocket)
# Use ws://localhost:9989/ws if running locally in Docker
WHISPER_WS_URI=ws://localhost:9989/ws

# Global Hotkey
# Format: ctrl+alt+w, f9, alt+r, etc.
# Note: This is a toggle key (one press to start, one to stop)
RECORD_HOTKEY=ctrl+alt+w

# Audio Device ID
# Leave empty for the system default input device, or run `uv run whisperdoc-terminal --setup`
# to choose a specific device interactively.
AUDIO_DEVICE_ID=

# Log Level (DEBUG, INFO, SUCCESS, ERROR)
LOG_LEVEL=INFO

# Idle Timeout (seconds) Disconnects from server after inactivity to free GPU resources.
IDLE_TIMEOUT=300

# Client Version
CLIENT_VERSION=2.23.6
